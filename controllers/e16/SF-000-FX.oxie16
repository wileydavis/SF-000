":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":1,"channel":15,"lower":0,"upper":127,"nr1":51,"nr2":8,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":15,"lower":0,"upper":127,"defaultValue":0,"nr1":19,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"EASY DK","abbr":"EADK","color":63,"push_action":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":1,"channel":15,"lower":0,"upper":127,"nr1":52,"nr2":9,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":15,"lower":0,"upper":127,"defaultValue":0,"nr1":20,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"EASY WM","abbr":"EAWM","color":50,"push_action":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":1,"channel":15,"lower":0,"upper":127,"nr1":53,"nr2":10,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":15,"lower":0,"upper":127,"defaultValue":0,"nr1":21,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"EASY CL","abbr":"EACL","color":18,"push_action":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":1,"channel":15,"lower":0,"upper":127,"nr1":54,"nr2":11,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":15,"lower":0,"upper":127,"defaultValue":0,"nr1":22,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"EASY BR","abbr":"EABR","color":34,"push_action":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":1,"channel":15,"lower":0,"upper":127,"nr1":55,"nr2":12,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":15,"lower":0,"upper":127,"defaultValue":0,"nr1":23,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"CALM DK","abbr":"CADK","color":63,"push_action":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":1,"channel":15,"lower":0,"upper":127,"nr1":56,"nr2":13,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":15,"lower":0,"upper":127,"defaultValue":0,"nr1":24,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"CALM WM","abbr":"CAWM","color":50,"push_action":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":1,"channel":15,"lower":0,"upper":127,"nr1":57,"nr2":14,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":15,"lower":0,"upper":127,"defaultValue":0,"nr1":25,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"CALM CL","abbr":"CACL","color":18,"push_action":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":1,"channel":15,"lower":0,"upper":127,"nr1":58,"nr2":15,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mo