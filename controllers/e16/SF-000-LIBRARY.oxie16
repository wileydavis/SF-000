M","abbr":"CAWM","color":50,"push_action":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":1,"channel":15,"lower":0,"upper":127,"nr1":57,"nr2":14,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":15,"lower":0,"upper":127,"defaultValue":0,"nr1":25,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"CALM CL","abbr":"CACL","color":18,"push_action":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":1,"channel":15,"lower":0,"upper":127,"nr1":58,"nr2":15,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":15,"lower":0,"upper":127,"defaultValue":0,"nr1":26,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"CALM BR","abbr":"CABR","color":34,"push_action":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":1,"channel":15,"lower":0,"upper":127,"nr1":59,"nr2":16,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":15,"lower":0,"upper":127,"defaultValue":0,"nr1":27,"nr2":0,"output":12,"scriptId":0},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0}]},{"title":"FIND","output":0,"channel":14,"encoders":[{"name":"RECENT","abbr":"RCNT","color":9,"push_action":{"instrument":127,"parameter":0,"type":2,"display":0,"mode":1,"channel":14,"lower":0,"upper":127,"nr1":44,"nr2":1,"output":0,"scriptId":0},"turn_actions":[{"instrument":127,"parameter":0,"type":3,"display":10,"mode":14,"channel":14,"lower":0,"upper":127,"defaultValue":0,"nr1":12,"nr